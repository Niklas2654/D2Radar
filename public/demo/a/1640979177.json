3% [?%] | x7 = 35% [?%]"}]}],"fromCopy":false,"versions":[1640979177,853736709,3669590332,3629120232,374306366,2252973221]},"copies":[{"instanceId":"6917530201904675576","itemHash":3629120232,"location":"vault","className":null,"characterId":null,"power":540,"tier":5,"energy":11,"stats":[{"hash":392767087,"name":"Health","icon":"/common/destiny2_content/icons/717b8b218cc14325a54869bef21d2964.png","value":0},{"hash":4244567218,"name":"Melee","icon":"/common/destiny2_content/icons/fa534aca76d7f2d7e7b4ba4df4271b42.png","value":20},{"hash":1735777505,"name":"Grenade","icon":"/common/destiny2_content/icons/065cdaabef560e5808e821cefaeaa22c.png","value":5},{"hash":144602215,"name":"Super","icon":"/common/destiny2_content/icons/585ae4ede9c3da96b34086fccccdc8cd.png","value":5},{"hash":1943323491,"name":"Class","icon":"/common/destiny2_content/icons/7eb845acb5b3a4a9b7e0b2f05f5c43f1.png","value":30},{"hash":2996146975,"name":"Weapons","icon":"/common/destiny2_content/icons/bc69675acdae9e6b9a68a02fb4d62e07.png","value":40}],"total":100,"item":{"hash":3629120232,"name":"Exodus Down Cloak","icon":"/common/destiny2_content/icons/11340a83dae4cb2daf0af60c68375665.jpg","typeName":"Hunter Cloak","exotic":false,"bucket":1585787867},"archetype":{"hash":2230428468,"name":"Specialist","icon":"/common/destiny2_content/icons/69731c603d7bcdd0a21b26c711d55f03.png","typeName":"","description":"Armor configured for Guardians who seek a flexible approach to combat.\n\nPrimary Stat: Class\nSecondary Stat: Weapons","exotic":false,"bucket":2422292810},"general":{"item":{"hash":4183296050,"name":"Weapons Mod","icon":"/common/destiny2_content/icons/4f970366cc18cab100e849926a927b6f.png","typeName":"General Armor Mod","description":"+10 Weapon ▲","exotic":false,"bucket":2422292810},"cost":3,"stats":[[2996146975,10]]},"tuning":{"item":{"hash":3121760799,"name":"+Weapons / -Health","icon":"/common/destiny2_content/icons/0899571e750ec89a444483bc8c0710ce.png","typeName":"General Armor Mod","description":"I